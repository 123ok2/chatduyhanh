{
  "entities": {
    "Message": {
      "title": "Message",
      "description": "A single chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender": { "type": "string", "enum": ["user", "duyhanh"] },
        "content": { "type": "string" },
        "isImage": { "type": "boolean" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "sender", "content", "timestamp"]
    },
    "ChatSession": {
      "title": "Chat Session",
      "description": "A chat session associated with a device fingerprint",
      "type": "object",
      "properties": {
        "fingerprintId": { "type": "string" },
        "messages": {
          "type": "array",
          "items": { "$ref": "#/entities/Message" }
        },
        "affectionLevel": { "type": "number", "minimum": 0, "maximum": 100 },
        "memory": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fingerprintId", "messages", "affectionLevel", "memory", "updatedAt"]
    }
  },
  "firestore": {
    "chats/{fingerprintId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "Stores chat history for a specific device fingerprint"
    }
  }
}
